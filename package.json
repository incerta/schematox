{
  "name": "schematox",
  "version": "1.3.1",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "jest --watch",
    "test:coverage": "vitest run --coverage",
    "formatter:fix": "prettier --write .",
    "formatter:check": "prettier --check . || (echo \"FORMATTING ERROR: use 'npm run formatter:fix'\" && exit 1)",
    "ts": "tsc -p tests/tsconfig.json",
    "check": "npm run formatter:check && npm run ts && npm run test:coverage",
    "morph": "jiti tests/fold-morph.ts && npm run formatter:fix",
    "release": "npm run check && bash scripts/prepare-release.sh",
    "publish:alpha": "bash scripts/publish-alpha.sh"
  },
  "peerDependencies": {
    "typescript": ">=5.3.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "prettier": "^3.9.4",
    "ts-morph": "^26.0.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.9"
  },
  "description": "Define JSON compatible schema statically/programmatically and parse its subject with typesafety",
  "author": "Kanstantsin Mazur",
  "license": "MIT",
  "keywords": [
    "typescript",
    "schema",
    "parser",
    "static schema definition",
    "programmatic schema definition",
    "branded primitives",
    "nominal types",
    "either style error handling",
    "lightweight"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/incerta/schematox.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ]
}
